{
  "name": "xupaoye/cangqiong-captcha",
  "description": "Cangqiong CAPTCHA: open-source image challenges and proof-of-work primitives implemented in PHP/GD.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "captcha",
    "cangqiong",
    "gd",
    "slider",
    "pow"
  ],
  "homepage": "https://github.com/XuPaoYe/cangqiong-captcha",
  "support": {
    "issues": "https://github.com/XuPaoYe/cangqiong-captcha/issues",
    "source": "https://github.com/XuPaoYe/cangqiong-captcha"
  },
  "require": {
    "php": "^8.4",
    "ext-gd": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Foundation\\Captcha\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "parity": "phpunit tests/ReferenceRegressionTest.php",
    "resources:check": "php scripts/check-resources.php",
    "templates:generate": "php scripts/generate-templates.php"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/build",
      "/writable",
      "/tests",
      "/scripts",
      "/.github",
      "/composer.lock",
      "/phpunit.xml.dist",
      "/.env",
      "/.gitignore",
      "/.gitattributes"
    ]
  }
}
